# IncidentVoice configuration. Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real keys. Values already exported in your terminal win.

# Gradium voice (speech-to-text in, text-to-speech out). Leave empty to disable voice.
GRADIUM_API_KEY=

# Local open-source model served by Ollama (must be pulled: `ollama pull qwen2.5:7b`)
INCIDENTVOICE_MODEL=qwen2.5:7b

# --- optional ---------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# GRADIUM_VOICE_ID=YTpq7expH9539ERJ
# GRADIUM_STT_URL=wss://api.gradium.ai/api/speech/asr
# GRADIUM_TTS_URL=wss://api.gradium.ai/api/speech/tts
# GRADIUM_PACE=0.25
# INCIDENTVOICE_EGRESS_LOG=egress_log.jsonl
